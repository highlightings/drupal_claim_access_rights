<?php

/**
 * @file
 * Core module logic for Claim Access Rights across all content entities.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;

/**
 * Implements hook_entity_access().
 *
 * Provides universal access control for nodes, custom blocks, media, taxonomy, etc.
 */
function claim_access_rights_entity_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResultInterface {
  /** @var \Drupal\claim_access_rights\ClaimAccessManagerInterface $manager */
  $manager = \Drupal::service('claim_access_rights.manager');

  if ($manager->hasAccess($entity, $account, $operation)) {
    return AccessResult::allowed()
      ->cachePerUser()
      ->addCacheableDependency($entity);
  }

  return AccessResult::neutral()
    ->cachePerUser()
    ->addCacheableDependency($entity);
}

/**
 * Implements hook_cron().
 */
function claim_access_rights_cron(): void {
  /** @var \Drupal\claim_access_rights\ClaimAccessManagerInterface $manager */
  $manager = \Drupal::service('claim_access_rights.manager');
  $manager->purgeExpiredGrants();
}

/**
 * Implements hook_entity_view().
 *
 * Injects claim callout or management banner on enabled entity view displays.
 */
function claim_access_rights_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  // Only display on full or default view modes.
  if (!in_array($view_mode, ['full', 'default'], TRUE)) {
    return;
  }

  $entity_type_id = $entity->getEntityTypeId();
  // Avoid recursion on internal or system entities.
  if (in_array($entity_type_id, ['webform_submission', 'user'], TRUE)) {
    return;
  }

  /** @var \Drupal\claim_access_rights\ClaimAccessManagerInterface $manager */
  $manager = \Drupal::service('claim_access_rights.manager');

  if (!method_exists($manager, 'isEntityTypeBundleEnabled') || !$manager->isEntityTypeBundleEnabled($entity_type_id, $entity->bundle())) {
    return;
  }

  $current_user = \Drupal::currentUser();
  $info = $manager->isClaimable($entity, $current_user);

  $entity_label = $entity->label() ?: ($entity_type_id . ' #' . $entity->id());
  $type_label = ucfirst(str_replace('_', ' ', $entity_type_id));

  $container = [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['claim-access-entity-box'],
      'style' => 'margin: 20px 0; padding: 16px; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc;',
    ],
    '#weight' => 50,
  ];

  if (!empty($info['user_is_claimant'])) {
    $grant = $info['grant'];
    $expires = (int) $grant['expires_at'] > 0
      ? \Drupal::service('date.formatter')->format((int) $grant['expires_at'], 'short')
      : (string) t('Never');

    $html = '<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">';
    $html .= '<div>';
    $html .= '<strong style="color:#166534; font-size:1.05em;">✓ You manage this ' . htmlspecialchars($type_label) . '</strong><br>';
    $html .= '<span style="color:#64748b; font-size:0.9em;">Granted Rights: ' . htmlspecialchars(strtoupper((string) $grant['rights'])) . ' | Expires: ' . htmlspecialchars($expires) . '</span>';
    $html .= '</div>';

    if (in_array('edit', explode(',', (string) $grant['rights']), TRUE) && $entity->hasLinkTemplate('edit-form')) {
      $edit_url = $entity->toUrl('edit-form')->toString();
      $html .= '<a href="' . $edit_url . '" class="button button--primary" style="background:#2563eb; color:#fff; padding:8px 16px; border-radius:6px; text-decoration:none; font-weight:600;">Edit ' . htmlspecialchars($type_label) . '</a>';
    }
    $html .= '</div>';

    $container['content'] = [
      '#markup' => $html,
    ];
  }
  elseif ($current_user->isAnonymous()) {
    $destination = $entity->hasLinkTemplate('canonical') ? $entity->toUrl()->toString() : '';
    $login_url = Url::fromRoute('user.login', [], ['query' => $destination ? ['destination' => $destination] : []])->toString();
    $container['content'] = [
      '#markup' => sprintf(
        '<div><strong>Want to manage this %s?</strong> <a href="%s" style="color:#2563eb; font-weight:bold;">Log in to claim access</a>.</div>',
        htmlspecialchars(strtolower($type_label)),
        $login_url
      ),
    ];
  }
  elseif ($info['claimable']) {
    $claim_url = Url::fromRoute('entity.webform.canonical', ['webform' => 'claim_listing'], [
      'query' => [
        'target_entity_type' => $entity_type_id,
        'target_entity_id' => $entity->id(),
        'target_entity_title' => $entity_label,
      ],
    ])->toString();

    $html = '<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">';
    $html .= '<div>';
    $html .= '<strong>Is this your ' . htmlspecialchars(strtolower($type_label)) . '?</strong><br>';
    $html .= '<span style="color:#64748b; font-size:0.9em;">Claim view and edit rights to manage details and updates.</span>';
    $html .= '</div>';
    $html .= '<a href="' . $claim_url . '" class="button button--primary claim-entity-btn" style="background:#16a34a; color:#fff; padding:8px 18px; border-radius:6px; text-decoration:none; font-weight:bold;">Claim This ' . htmlspecialchars($type_label) . '</a>';
    $html .= '</div>';

    $container['content'] = [
      '#markup' => $html,
    ];
  }
  else {
    $container['content'] = [
      '#markup' => '<div style="color:#64748b;"><em>' . htmlspecialchars($info['reason']) . '</em></div>',
    ];
  }

  $build['claim_access_box'] = $container;
}
