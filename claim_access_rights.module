<?php

/**
 * @file
 * Core module logic for Claim Access Rights across all content entities.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\claim_access_rights\ClaimAccessManager;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;

/**
 * Implements hook_entity_access().
 *
 * Provides universal access control for nodes, custom blocks, media, taxonomy, etc.
 */
function claim_access_rights_entity_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResultInterface {
  /** @var \Drupal\claim_access_rights\ClaimAccessManagerInterface $manager */
  $manager = \Drupal::service('claim_access_rights.manager');

  // Keep the common case cheap and cache-friendly: anonymous users and
  // entities that are not claimable never depend on per-user grants.
  if ($account->isAnonymous() || !$entity->id()
    || !$manager->isEntityTypeBundleEnabled($entity->getEntityTypeId(), $entity->bundle())) {
    return AccessResult::neutral()
      ->addCacheContexts(['user.roles:anonymous'])
      ->addCacheTags(['config:claim_access_rights.settings']);
  }

  $result = $manager->hasAccess($entity, $account, $operation)
    ? AccessResult::allowed()
    : AccessResult::neutral();

  // Grants are time-based: the max-age stops a cached result from outliving a
  // start or expiry boundary, and the per-entity tag covers every mutation.
  $metadata = $manager->getAccessCacheMetadata($entity, $account);
  return $result
    ->cachePerUser()
    ->addCacheableDependency($entity)
    ->addCacheTags($metadata['tags'])
    ->setCacheMaxAge($metadata['max_age']);
}

/**
 * Implements hook_cron().
 */
function claim_access_rights_cron(): void {
  /** @var \Drupal\claim_access_rights\ClaimAccessManagerInterface $manager */
  $manager = \Drupal::service('claim_access_rights.manager');
  $manager->purgeExpiredGrants();
}

/**
 * Implements hook_entity_delete().
 *
 * Automatically cleans up associated claim access grants when an entity or user is deleted.
 */
function claim_access_rights_entity_delete(EntityInterface $entity): void {
  $entity_type_id = $entity->getEntityTypeId();
  if (in_array($entity_type_id, ['webform_submission'], TRUE)) {
    return;
  }

  /** @var \Drupal\claim_access_rights\ClaimAccessManagerInterface $manager */
  $manager = \Drupal::service('claim_access_rights.manager');

  if ($entity_type_id === 'user') {
    $manager->deleteGrantsForUser((int) $entity->id());
  }

  $manager->deleteGrantsForEntity($entity_type_id, (int) $entity->id());
}

/**
 * Implements hook_entity_trash_delete().
 *
 * Automatically cleans up claim access grants when an entity is soft-deleted to trash.
 */
function claim_access_rights_entity_trash_delete(EntityInterface $entity): void {
  claim_access_rights_entity_delete($entity);
}

/**
 * Implements hook_entity_view().
 *
 * Injects claim callout or management banner on enabled entity view displays.
 */
function claim_access_rights_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  // Only display on full or default view modes.
  if (!in_array($view_mode, ['full', 'default'], TRUE)) {
    return;
  }

  $entity_type_id = $entity->getEntityTypeId();
  // Avoid recursion on internal or system entities.
  if (in_array($entity_type_id, ['webform_submission', 'user'], TRUE)) {
    return;
  }

  /** @var \Drupal\claim_access_rights\ClaimAccessManagerInterface $manager */
  $manager = \Drupal::service('claim_access_rights.manager');

  if (!$manager->isEntityTypeBundleEnabled($entity_type_id, $entity->bundle())) {
    return;
  }

  $current_user = \Drupal::currentUser();
  $info = $manager->isClaimable($entity, $current_user);

  $entity_label = $entity->label() ?: ($entity_type_id . ' #' . $entity->id());
  $type_label = ucfirst(str_replace('_', ' ', $entity_type_id));

  $container = [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['claim-access-entity-box'],
      'style' => 'margin: 20px 0; padding: 16px; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc;',
    ],
    '#weight' => 50,
    // The banner depends on the viewer and on every grant on this entity, and
    // changes when any of them starts or ends.
    '#cache' => [
      'contexts' => ['user'],
      'tags' => [
        'config:claim_access_rights.settings',
        ClaimAccessManager::entityTag($entity_type_id, (string) $entity->id()),
      ],
      'max-age' => $manager->getGrantsMaxAge($info['active_grants'] ?? []),
    ],
  ];

  if (!empty($info['user_is_claimant'])) {
    $grant = $info['grant'];
    $expires = (int) $grant['expires_at'] > 0
      ? \Drupal::service('date.formatter')->format((int) $grant['expires_at'], 'short')
      : (string) t('Never');

    $html = '<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">';
    $html .= '<div>';
    $html .= '<strong style="color:#166534; font-size:1.05em;">✓ You manage this ' . htmlspecialchars($type_label) . '</strong><br>';
    $html .= '<span style="color:#64748b; font-size:0.9em;">Granted Rights: ' . htmlspecialchars(strtoupper((string) $grant['rights'])) . ' | Expires: ' . htmlspecialchars($expires) . '</span>';
    $html .= '</div>';

    if (in_array('edit', explode(',', (string) $grant['rights']), TRUE) && $entity->hasLinkTemplate('edit-form')) {
      $edit_url = $entity->toUrl('edit-form')->toString();
      $html .= '<a href="' . $edit_url . '" class="button button--primary" style="background:#2563eb; color:#fff; padding:8px 16px; border-radius:6px; text-decoration:none; font-weight:600;">Edit ' . htmlspecialchars($type_label) . '</a>';
    }
    $html .= '</div>';

    $container['content'] = [
      '#type' => 'inline_template',
      '#template' => '{{ html|raw }}',
      '#context' => ['html' => $html],
    ];
  }
  elseif (!empty($info['permanently_claimed'])) {
    $html = '<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">';
    $html .= '<div>';
    $html .= '<strong style="color:#475569;">Exclusive Access Granted</strong><br>';
    $html .= '<span style="color:#64748b; font-size:0.9em;">This ' . htmlspecialchars(strtolower($type_label)) . ' has been claimed indefinitely under exclusive access. New access requests cannot be accepted.</span>';
    $html .= '</div>';
    $html .= '<button disabled class="button button--disabled" style="background:#cbd5e1; color:#64748b; padding:8px 18px; border-radius:6px; font-weight:bold; border:1px solid #94a3b8; cursor:not-allowed;" title="Claiming is not possible for content with indefinite exclusive access.">Claiming Unavailable</button>';
    $html .= '</div>';

    $container['content'] = [
      '#type' => 'inline_template',
      '#template' => '{{ html|raw }}',
      '#context' => ['html' => $html],
    ];
  }
  elseif ($current_user->isAnonymous()) {
    $destination = $entity->hasLinkTemplate('canonical') ? $entity->toUrl()->toString() : '';
    $login_url = Url::fromRoute('user.login', [], ['query' => $destination ? ['destination' => $destination] : []])->toString();
    $html = sprintf(
      '<div><strong>Want to manage this %s?</strong> <a href="%s" style="color:#2563eb; font-weight:bold;">Log in to claim access</a>.</div>',
      htmlspecialchars(strtolower($type_label)),
      $login_url
    );
    $container['content'] = [
      '#type' => 'inline_template',
      '#template' => '{{ html|raw }}',
      '#context' => ['html' => $html],
    ];
  }
  elseif ($info['claimable']) {
    $claim_url = Url::fromRoute('entity.webform.canonical', ['webform' => 'claim_listing'], [
      'query' => [
        'target_entity_type' => $entity_type_id,
        'target_entity_id' => $entity->id(),
        'target_entity_title' => $entity_label,
      ],
    ])->toString();

    $notice_text = !empty($info['has_exclusive_windows'])
      ? 'Exclusive access is active for specific dates. You can claim access for non-overlapping dates.'
      : 'Claim view and edit rights to manage details and updates.';

    $html = '<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">';
    $html .= '<div>';
    $html .= '<strong>Is this your ' . htmlspecialchars(strtolower($type_label)) . '?</strong><br>';
    $html .= '<span style="color:#64748b; font-size:0.9em;">' . htmlspecialchars($notice_text) . '</span>';
    $html .= '</div>';
    $html .= '<a href="' . $claim_url . '" class="button button--primary claim-entity-btn" style="background:#16a34a; color:#fff; padding:8px 18px; border-radius:6px; text-decoration:none; font-weight:bold;">Claim This ' . htmlspecialchars($type_label) . '</a>';
    $html .= '</div>';

    $container['content'] = [
      '#type' => 'inline_template',
      '#template' => '{{ html|raw }}',
      '#context' => ['html' => $html],
    ];
  }
  else {
    $html = '<div style="color:#64748b;"><em>' . htmlspecialchars($info['reason']) . '</em></div>';
    $container['content'] = [
      '#type' => 'inline_template',
      '#template' => '{{ html|raw }}',
      '#context' => ['html' => $html],
    ];
  }

  $build['claim_access_box'] = $container;
}

/**
 * Implements hook_form_FORM_ID_alter() for webform_submission_claim_listing_add_form.
 */
function claim_access_rights_form_webform_submission_claim_listing_add_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  $form['#validate'][] = 'claim_access_rights_claim_listing_form_validate';
}

/**
 * Custom validation callback for claim listing webform submissions.
 */
function claim_access_rights_claim_listing_form_validate(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $entity_type = (string) $form_state->getValue('target_entity_type') ?: 'node';
  $entity_id = (int) $form_state->getValue('target_entity_id');

  if (!$entity_id) {
    return;
  }

  /** @var \Drupal\claim_access_rights\ClaimAccessManagerInterface $manager */
  $manager = \Drupal::service('claim_access_rights.manager');

  $start_date_val = $form_state->getValue('start_date');
  $no_end_date = (bool) $form_state->getValue('no_end_date');
  $end_date_val = $form_state->getValue('end_date');
  $now = \Drupal::time()->getRequestTime();

  $starts_at = !empty($start_date_val) ? strtotime((string) $start_date_val) : $now;
  if ($starts_at === FALSE) {
    $form_state->setErrorByName('start_date', t('Please enter a valid start date.'));
    return;
  }
  if ($no_end_date) {
    $expires_at = 0;
  }
  elseif (!empty($end_date_val)) {
    $expires_at = strtotime((string) $end_date_val . ' 23:59:59');
    if ($expires_at === FALSE) {
      $form_state->setErrorByName('end_date', t('Please enter a valid end date.'));
      return;
    }
  }
  else {
    $form_state->setErrorByName('end_date', t('Please choose an end date or request permanent access.'));
    return;
  }

  // Window limits (permanent claims, maximum length/advance) and per-user cap.
  $error = $manager->validateClaimWindow($starts_at, $expires_at)
    ?? $manager->validateUserClaimLimit((int) \Drupal::currentUser()->id());
  if ($error !== NULL) {
    $form_state->setErrorByName('end_date', $error);
    return;
  }

  // Check overlapping exclusive grants.
  $conflict = $manager->getOverlappingExclusiveGrant($entity_type, $entity_id, $starts_at, $expires_at);
  if ($conflict) {
    $current_uid = (int) \Drupal::currentUser()->id();
    if ((int) $conflict['uid'] !== $current_uid) {
      $conf_start = \Drupal::service('date.formatter')->format((int) ($conflict['starts_at'] ?: $conflict['created']), 'custom', 'M j, Y');
      $conf_end = (int) $conflict['expires_at'] === 0 ? t('Indefinite (No End Date)') : \Drupal::service('date.formatter')->format((int) $conflict['expires_at'], 'custom', 'M j, Y');

      $form_state->setErrorByName('start_date', t(
        'Access is already exclusively reserved for this content from @start to @end. Access is not possible during this overlapping duration. Please choose dates outside this window.',
        ['@start' => $conf_start, '@end' => $conf_end]
      ));
    }
  }
}

/**
 * Implements hook_preprocess_views_view_table().
 *
 * Applies a distinct visual highlight to indefinite (no-expiry) claims in the table.
 */
function claim_access_rights_preprocess_views_view_table(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view || !in_array($view->id(), ['claim_access_grants'], TRUE)) {
    return;
  }

  foreach ($variables['rows'] as $index => $row) {
    $result_row = $view->result[$index] ?? NULL;
    if (!$result_row) {
      continue;
    }

    $expires_at = (int) ($result_row->claim_access_grants_expires_at ?? $result_row->expires_at ?? -1);
    if ($expires_at === 0 && isset($variables['rows'][$index]['attributes'])) {
      $variables['rows'][$index]['attributes']->addClass('claim-row--indefinite');
      $existing_style = (string) $variables['rows'][$index]['attributes']->offsetGet('style');
      $variables['rows'][$index]['attributes']->setAttribute(
        'style',
        trim($existing_style . ' background-color: #faf5ff; border-left: 3px solid #8b5cf6;')
      );
    }
  }
}

